# ==============================================================================
# Environment Configuration Template for Interview with My Digital Twin
# ==============================================================================

# Ollama Inference Host Service URL
OLLAMA_URL=http://localhost:11434

# Consolidated PostgreSQL Database Connection String (pgvector enabled)
PG_DSN=postgresql://postgres:postgres@localhost:5432/twin_db

# Abuse Tracker Database Path
TRACKER_DB=abuse_tracker.db

# SMTP Configuration for Verification OTPs & Lead Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=placeholder_app_password

# Service Port
PORT=8000
