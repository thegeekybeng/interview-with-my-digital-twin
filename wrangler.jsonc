{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-digital-twin",
  "compatibility_date": "2026-10-27",
  "pages_build_output_dir": "frontend/dist",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
